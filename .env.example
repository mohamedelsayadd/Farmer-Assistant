APP_NAME=ReNile Farmer Assistant
APP_ENV=local
LOG_LEVEL=INFO

LLM_API_KEY=EMPTY
LLM_BASE_URL=http://localhost:5000/v1
LLM_MODEL=cyankiwi/Qwen3.6-27B-AWQ-INT4
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.8
LLM_TOP_K=20

REDIS_URL=redis://localhost:6379/0
REDIS_MEMORY_TTL_SECONDS=3600
REDIS_MEMORY_MAX_MESSAGES=12
REDIS_TOOL_CACHE_URL=redis://localhost:6379/1
REDIS_TOOL_CACHE_TTL_SECONDS=600

RENILE_API_BASE_URL=https://renile-iot.com
RENILE_CURRENT_READINGS_PATH=/api/users/devices/
RENILE_HISTORICAL_READINGS_PATH=/api/v1/data/

HTTP_TIMEOUT_SECONDS=40

STT_MODEL=Systran/faster-whisper-large-v3
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ar
STT_MAX_AUDIO_BYTES=10485760

TTS_MODEL=k2-fsa/OmniVoice
TTS_DEVICE_MAP=cuda:0
TTS_DTYPE=float16
TTS_SAMPLE_RATE=24000
TTS_REFERENCE_AUDIO_PATH=./3.wav

CHAT_API_BASE_URL=http://localhost:8000
