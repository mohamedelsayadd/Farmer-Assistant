# .env is the single source of truth for configuration.
# Every key below is required by src/core/config.py — there are no in-code
# defaults, so a missing key raises a validation error at startup.

APP_NAME=ReNile Farmer Assistant
APP_ENV=local
LOG_LEVEL=INFO

LLM_API_KEY=EMPTY
LLM_BASE_URL=http://localhost:5000/v1
LLM_MODEL=cyankiwi/Qwen3.6-27B-AWQ-INT4
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.8
LLM_TOP_K=20

REDIS_URL=redis://localhost:6379/0
REDIS_MEMORY_TTL_SECONDS=3600
REDIS_MEMORY_MAX_MESSAGES=12
REDIS_TOOL_CACHE_URL=redis://localhost:6379/1
REDIS_TOOL_CACHE_TTL_SECONDS=600

RENILE_API_BASE_URL=https://renile-iot.com
RENILE_DEVICES_PATH=/api/v1/devices/names/
RENILE_CURRENT_READINGS_PATH=/api/v1/snapshot
RENILE_HISTORICAL_READINGS_PATH=/api/v1/data/

HTTP_TIMEOUT_SECONDS=40

# supported providers: cohere, faster_whisper
ASR_PROVIDER=cohere
ASR_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
ASR_DEVICE=cuda:0
# required for the cohere provider; leave empty only with faster_whisper for auto detection
ASR_LANGUAGE=ar
ASR_MAX_AUDIO_BYTES=524288
# faster_whisper only
ASR_COMPUTE_TYPE=int8
# cohere only
ASR_DTYPE=float16
ASR_MAX_NEW_TOKENS=256

TTS_PROVIDER=voicetut
TTS_MODEL=mohammedaly22/VoiceTut-TTS
TTS_DEVICE=cuda:0
TTS_DTYPE=float16
# names = ["Abdelrahman", "Abdullah", "Kamal", "Hossam", "Mohamed", "Omar", "Sayed", "Zaki", "Aly", "Essam", "Ahmed", "Asmaa", "Esraa", "Hanan", "Sarah", "Yasmin", "Omnia"]
TTS_SPEAKER=Asmaa
TTS_NUM_STEP=48
TTS_GUIDANCE_SCALE=2.5
TTS_SPEED=1.05

# used by streamlit_app.py only
CHAT_API_BASE_URL=http://localhost:8000
