# .env is the single source of truth for configuration.
# Every key below is required by src/core/config.py — there are no in-code
# defaults, so a missing key raises a validation error at startup.

APP_NAME=ReNile Farmer Assistant
APP_ENV=local
LOG_LEVEL=INFO

LLM_API_KEY=EMPTY
LLM_BASE_URL=http://localhost:5000/v1
LLM_MODEL=cyankiwi/Qwen3.6-27B-AWQ-INT4
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.8
LLM_TOP_K=20

REDIS_URL=redis://localhost:6379/0
REDIS_MEMORY_TTL_SECONDS=3600
REDIS_MEMORY_MAX_MESSAGES=12
REDIS_TOOL_CACHE_URL=redis://localhost:6379/1
REDIS_TOOL_CACHE_TTL_SECONDS=600

RENILE_API_BASE_URL=https://renile-iot.com
RENILE_DEVICES_PATH=/api/v1/devices/names/
RENILE_CURRENT_READINGS_PATH=/api/v1/snapshot
RENILE_HISTORICAL_READINGS_PATH=/api/v1/data/

PLANT_DISEASE_API_BASE_URL=http://127.0.0.1:8002
PLANT_DISEASE_PREDICT_PATH=/api/v1/predict
PLANT_DISEASE_MAX_IMAGE_BYTES=5242880

HTTP_TIMEOUT_SECONDS=40

# supported providers: fms_voice (remote FMS-Voice service)
ASR_PROVIDER=fms_voice
# ar or en; empty lets FMS-Voice apply its default
ASR_LANGUAGE=ar
ASR_MAX_AUDIO_BYTES=10485760
# see ASR-API-Contract.md
ASR_REMOTE_BASE_URL=http://127.0.0.1:5001
ASR_REMOTE_TRANSCRIBE_PATH=/transcribe
ASR_REMOTE_TIMEOUT_SECONDS=120

# langfuse observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
